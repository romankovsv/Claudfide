    "deny": [
      "Bash(terraform:*)",
      "Bash(tofu:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git rebase:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "WebFetch",
      "WebSearch"
    ]
  }
}
